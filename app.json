{
  "expo": {
    "name": "woma-mobile",
    "slug": "woma-mobile",
    "scheme": "woma-mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/home_icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kouheimitsumura.app",
      "buildNumber": "9",
      "googleServicesFile": "./GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSHealthShareUsageDescription": "今日の歩数を取得し、活動記録グラフに表示して運動不足解消をサポートするために使用します。",
        "NSHealthUpdateUsageDescription": "アプリ内で記録した運動データをヘルスケアに保存し、活動履歴を一元管理するために使用します。",
        "NSCameraUsageDescription": "プロフィール写真の撮影や、チャットでの写真送信のためにカメラを使用します。",
        "NSPhotoLibraryUsageDescription": "プロフィール画像の設定や、チャットでの写真送信のためにライブラリへアクセスします。",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.540454404812-p95ail006s113tvlthe8vb542a953c4j"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.kouheimitsumura.app",
      "versionCode": 9,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.health.READ_STEPS",
        "android.permission.health.WRITE_STEPS",
        "com.google.android.gms.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "newArchEnabled": true
          },
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 26,
            "buildToolsVersion": "35.0.0",
            "newArchEnabled": true
          }
        }
      ],
      [
        "react-native-health",
        {
          "isVitalsEnabled": false,
          "isSleepEnabled": false,
          "isWorkoutEnabled": false
        }
      ],
      [
        "react-native-health-connect",
        {
          "rationaleActivityHeader": "歩数データの利用",
          "rationaleActivityDescription": "WOMAは、日々の運動を記録するためにHealth Connectへのアクセス許可が必要です。",
          "permissions": [
            {
              "accessType": "read",
              "recordType": "Steps"
            }
          ]
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "03457d1f-c639-416b-ae61-1538203cde78"
      }
    }
  }
}